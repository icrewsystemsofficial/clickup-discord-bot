{
  "info": {
    "_postman_id": "84d45e6b-a348-4487-a1ab-3bb15fdde072",
    "name": "Cerebro AI Agent API",
    "description": "AI-agent-only Cerebro API collection. Use the static AI_AGENT_API_TOKEN as X-AI-Agent-Token. Task endpoints in this collection are ClickUp tasks only.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 - User Lookup",
      "item": [
        {
          "name": "All Staff Users",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-AI-Agent-Token",
                "value": "{{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/ai-agent/staff-users",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "ai-agent",
                "staff-users"
              ]
            },
            "description": "Returns all active staff users with Cerebro user ID, Discord ID, and ClickUp ID."
          },
          "response": []
        },
        {
          "name": "User Details By Cerebro User ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-AI-Agent-Token",
                "value": "{{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/ai-agent/users/{{user_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "ai-agent",
                "users",
                "{{user_id}}"
              ]
            },
            "description": "Returns one active staff user by Cerebro user ID."
          },
          "response": []
        },
        {
          "name": "User Details By Discord ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-AI-Agent-Token",
                "value": "{{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/ai-agent/discord-users/{{discord_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "ai-agent",
                "discord-users",
                "{{discord_id}}"
              ]
            },
            "description": "Returns the Cerebro staff user mapped to a Discord user ID. Accepts raw Discord ID or mention-like values."
          },
          "response": []
        }
      ]
    },
    {
      "name": "02 - Clock-In Details",
      "item": [
        {
          "name": "All Staff Clock-In Details",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-AI-Agent-Token",
                "value": "{{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/ai-agent/clock-in-details?date={{date}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "ai-agent",
                "clock-in-details"
              ],
              "query": [
                {
                  "key": "date",
                  "value": "{{date}}",
                  "description": "Optional. Defaults to today in Asia/Kolkata."
                }
              ]
            },
            "description": "Returns clock-in details for every active staff user for the selected date."
          },
          "response": []
        },
        {
          "name": "User Clock-In Details By Cerebro User ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-AI-Agent-Token",
                "value": "{{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/ai-agent/users/{{user_id}}/clock-in-details?date={{date}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "ai-agent",
                "users",
                "{{user_id}}",
                "clock-in-details"
              ],
              "query": [
                {
                  "key": "date",
                  "value": "{{date}}",
                  "description": "Optional. Defaults to today in Asia/Kolkata."
                }
              ]
            },
            "description": "Returns clock-in records for one user by Cerebro user ID."
          },
          "response": []
        },
        {
          "name": "User Clock-In Details By Discord ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-AI-Agent-Token",
                "value": "{{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/ai-agent/discord-users/{{discord_id}}/clock-in-details?date={{date}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "ai-agent",
                "discord-users",
                "{{discord_id}}",
                "clock-in-details"
              ],
              "query": [
                {
                  "key": "date",
                  "value": "{{date}}",
                  "description": "Optional. Defaults to today in Asia/Kolkata."
                }
              ]
            },
            "description": "Returns clock-in records for the staff user mapped to a Discord ID."
          },
          "response": []
        }
      ]
    },
    {
      "name": "03 - ClickUp Tasks",
      "item": [
        {
          "name": "All Staff ClickUp Tasks",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-AI-Agent-Token",
                "value": "{{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/ai-agent/clickup-tasks?filter={{task_filter}}&date={{date}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "ai-agent",
                "clickup-tasks"
              ],
              "query": [
                {
                  "key": "filter",
                  "value": "{{task_filter}}",
                  "description": "all, pending, open, closed, completed, today, upcoming, delayed, overdue"
                },
                {
                  "key": "date",
                  "value": "{{date}}",
                  "description": "Used by today and upcoming filters."
                },
                {
                  "key": "list_id",
                  "value": "{{clickup_list_id}}",
                  "disabled": true,
                  "description": "Optional. Enable to limit to one ClickUp list."
                }
              ]
            },
            "description": "Returns ClickUp tasks grouped by staff user. Each task includes URL and status details."
          },
          "response": []
        },
        {
          "name": "All Staff Pending ClickUp Tasks",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-AI-Agent-Token",
                "value": "{{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/ai-agent/clickup-tasks/pending?date={{date}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "ai-agent",
                "clickup-tasks",
                "pending"
              ],
              "query": [
                {
                  "key": "date",
                  "value": "{{date}}",
                  "description": "Optional reference date."
                },
                {
                  "key": "list_id",
                  "value": "{{clickup_list_id}}",
                  "disabled": true,
                  "description": "Optional. Enable to limit to one ClickUp list."
                }
              ]
            },
            "description": "Returns pending/open ClickUp tasks for all mapped staff users with task URLs."
          },
          "response": []
        },
        {
          "name": "User ClickUp Tasks By Cerebro User ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-AI-Agent-Token",
                "value": "{{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/ai-agent/users/{{user_id}}/clickup-tasks?filter={{task_filter}}&date={{date}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "ai-agent",
                "users",
                "{{user_id}}",
                "clickup-tasks"
              ],
              "query": [
                {
                  "key": "filter",
                  "value": "{{task_filter}}",
                  "description": "all, pending, open, closed, completed, today, upcoming, delayed, overdue"
                },
                {
                  "key": "date",
                  "value": "{{date}}"
                },
                {
                  "key": "list_id",
                  "value": "{{clickup_list_id}}",
                  "disabled": true,
                  "description": "Optional. Enable to limit to one ClickUp list."
                }
              ]
            },
            "description": "Returns ClickUp tasks for one staff user by Cerebro user ID."
          },
          "response": []
        },
        {
          "name": "User ClickUp Tasks By Discord ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-AI-Agent-Token",
                "value": "{{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/ai-agent/discord-users/{{discord_id}}/clickup-tasks?filter={{task_filter}}&date={{date}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "ai-agent",
                "discord-users",
                "{{discord_id}}",
                "clickup-tasks"
              ],
              "query": [
                {
                  "key": "filter",
                  "value": "{{task_filter}}",
                  "description": "all, pending, open, closed, completed, today, upcoming, delayed, overdue"
                },
                {
                  "key": "date",
                  "value": "{{date}}"
                },
                {
                  "key": "list_id",
                  "value": "{{clickup_list_id}}",
                  "disabled": true,
                  "description": "Optional. Enable to limit to one ClickUp list."
                }
              ]
            },
            "description": "Returns ClickUp tasks for the staff user mapped to a Discord ID."
          },
          "response": []
        },
        {
          "name": "Create ClickUp Task",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-AI-Agent-Token",
                "value": "{{token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"list_id\": \"{{clickup_list_id}}\",\n  \"name\": \"AI Agent Test Task\",\n  \"description\": \"Created from the Cerebro AI Agent API Postman collection.\",\n  \"user_id\": {{user_id}},\n  \"status\": \"assigned\",\n  \"priority\": 3,\n  \"due_date\": \"{{date}}\",\n  \"time_estimate\": 3600000,\n  \"notify_all\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/ai-agent/clickup/tasks",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "ai-agent",
                "clickup",
                "tasks"
              ]
            },
            "description": "Creates a ClickUp task. Pass user_id to assign by Cerebro user ID, or pass assignees with ClickUp user IDs directly."
          },
          "response": []
        }
      ]
    },
    {
      "name": "04 - SOP",
      "item": [
        {
          "name": "SOP Details",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-AI-Agent-Token",
                "value": "{{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/ai-agent/sop-details",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "ai-agent",
                "sop-details"
              ]
            },
            "description": "Returns SOP references exposed for AI agents."
          },
          "response": []
        }
      ]
    }
  ],
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('response is JSON', function () {",
          "    pm.response.to.be.json;",
          "});"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "https://cerebro.icrewsystems.com"
